# Product Composer production env
# Copy to /opt/product-composer/.env on the server and fill real values.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Auth
ACTIVATION_CODE=change-me
COOKIE_SECRET=replace-with-a-long-random-secret

# LLM, optional. Leave DEEPSEEK_API_KEY empty to use keyword fallback only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=15000
