{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taomarte Product Initiation Expert Output Schema",
  "type": "object",
  "required": ["decision_summary", "module_precheck", "scorecard", "path_output", "task_dispatch"],
  "properties": {
    "decision_summary": {
      "type": "object",
      "properties": {
        "initiation_id": { "type": "string" },
        "initiation_name": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "project_type": {
          "type": "string",
          "enum": ["品类地图缺失", "竞品产品升级", "现有爆品升级", "未起量产品升级", "需人工确认"]
        },
        "total_score": { "type": ["number", "null"] },
        "recommendation": {
          "type": "string",
          "enum": ["建议立项", "小样测试", "暂缓补资料", "不建议立项", "止损", "需人工确认"]
        },
        "core_reason": { "type": "string" },
        "biggest_opportunity": { "type": "string" },
        "biggest_risk": { "type": "string" },
        "next_agent": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "可同时触发多个下游智能体"
        },
        "agent_version": {
          "type": "string",
          "description": "本次判断使用的立项专家版本，例如 v1.1.0"
        },
        "cross_tier_review_required": {
          "type": "boolean",
          "description": "总分是否落在档位边界，需人工二审"
        },
        "module_gate_result": {
          "type": "string",
          "enum": ["模块高复用，可快速推进", "模块中等复用，建议小样测试", "模块低复用，默认暂缓", "核心模块缺失，不建议直接立项", "需人工确认"]
        },
        "estimated_module_reuse_rate": { "type": ["number", "null"] },
        "manual_confirmation_required": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "module_precheck": {
      "type": "object",
      "properties": {
        "overall_reuse_rate": { "type": ["number", "null"] },
        "module_gate_result": { "type": "string" },
        "module_based_initiation_reason": {
          "type": "string",
          "enum": ["因已有模块可快速升级", "因升级中可复用模块降低难度", "因关键模块缺失提高风险", "模块信息不足需确认", "不适用"]
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module_dimension": {
                "type": "string",
                "enum": ["版型模块", "材料模块", "结构模块", "外观模块", "功能模块", "包装模块"]
              },
              "expected_module": { "type": "string" },
              "match_status": {
                "type": "string",
                "enum": ["可复用", "可改良", "需新增", "无效/禁用", "需人工确认"]
              },
              "reuse_rate": { "type": ["number", "null"] },
              "matched_module_id": { "type": "string" },
              "module_impact_on_initiation": { "type": "string" },
              "unknowns": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "missing_core_modules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommended_module_next_action": { "type": "string" }
      }
    },
    "scorecard": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "description": "必须输出全部 8 个维度，缺一不可",
      "items": {
        "type": "object",
        "required": ["dimension", "max_score", "score"],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "市场需求",
              "竞品验证",
              "品牌承载力",
              "差异化空间",
              "供应链可行性",
              "内容表达性",
              "模块复用价值",
              "成本和价格带合理性"
            ]
          },
          "max_score": { "type": "number", "enum": [5, 10, 15, 20] },
          "score": { "type": ["number", "null"] },
          "reason": { "type": "string" },
          "unknowns": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "path_output": {
      "type": "object",
      "properties": {
        "category_missing_output": { "type": "object" },
        "competitor_upgrade_output": { "type": "object" },
        "hit_product_upgrade_output": { "type": "object" },
        "underperforming_product_diagnosis": { "type": "object" }
      }
    },
    "risk_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk": { "type": "string" },
          "severity": { "type": "string", "enum": ["高", "中", "低", "需人工确认"] },
          "owner": { "type": "string" },
          "next_action": { "type": "string" }
        }
      }
    },
    "task_dispatch": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_name": { "type": "string" },
          "owner": { "type": "string" },
          "deadline": { "type": "string" },
          "output": { "type": "string" },
          "target_agent": { "type": "string" }
        }
      }
    },
    "feishu_update": {
      "type": "object",
      "properties": {
        "table_product_initiation_pool": { "type": "object" },
        "table_module_precheck": { "type": "array" },
        "table_initiation_scorecard": { "type": "array" },
        "table_task_dispatch": { "type": "array" }
      }
    }
  }
}
