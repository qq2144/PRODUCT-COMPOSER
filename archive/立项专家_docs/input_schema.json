{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taomarte Product Initiation Expert Input Schema",
  "type": "object",
  "required": ["basic_info", "opportunity_info"],
  "properties": {
    "basic_info": {
      "type": "object",
      "required": ["initiation_name", "brand", "category", "opportunity_source"],
      "properties": {
        "initiation_id": { "type": "string" },
        "initiation_name": { "type": "string" },
        "brand": {
          "type": "string",
          "enum": ["Seruna", "ENYISA", "奈肤 Silk-Skin", "JFK", "TMT", "其他"]
        },
        "category": { "type": "string" },
        "opportunity_source": {
          "type": "string",
          "enum": ["品类缺失", "竞品", "自有爆品", "未起量产品", "运营反馈", "销售反馈", "老板输入", "其他"]
        },
        "submitter": { "type": "string" },
        "target_channel": {
          "type": "array",
          "items": { "type": "string" }
        },
        "target_price_band": { "type": "string" },
        "expected_launch_time": { "type": "string" }
      }
    },
    "opportunity_info": {
      "type": "object",
      "properties": {
        "product_or_idea_description": { "type": "string" },
        "target_user": { "type": "string" },
        "usage_scenario": { "type": "string" },
        "core_pain_points": {
          "type": "array",
          "items": { "type": "string" }
        },
        "product_links": {
          "type": "array",
          "items": { "type": "string" }
        },
        "attachments_or_images": {
          "type": "array",
          "items": { "type": "string" }
        },
        "has_existing_internal_product": {
          "type": "string",
          "enum": ["有", "没有", "需人工确认"]
        },
        "has_competitor_validation": {
          "type": "string",
          "enum": ["是", "否", "需人工确认"]
        },
        "known_competitors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "brand": { "type": "string" },
              "product_name": { "type": "string" },
              "link": { "type": "string" },
              "price": { "type": "string" },
              "sales_signal": { "type": "string" },
              "positive_feedback": { "type": "string" },
              "negative_feedback": { "type": "string" }
            }
          }
        },
        "current_sales_performance": {
          "type": "object",
          "properties": {
            "monthly_sales": { "type": "string" },
            "conversion_rate": { "type": "string" },
            "return_rate": { "type": "string" },
            "gross_margin": { "type": "string" },
            "review_keywords": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "known_issues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supply_chain_resources": { "type": "string" },
        "brand_asset_space": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["品牌色", "品牌符号", "品牌材料", "品牌语言", "系列识别", "包装一致性", "结构语言", "需人工确认"]
          }
        },
        "module_reuse_clues": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "budget_or_target_cost": { "type": "string" },
        "sampling_deadline": { "type": "string" },
        "forbidden_directions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "must_check_points": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
