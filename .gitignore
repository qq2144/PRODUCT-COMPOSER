# ============================================
# 淘玛特立项专家 - 仓库忽略规则
# ============================================

# 货盘原始 xlsx（合计 ~100MB，太大不入库；保留沉淀脚本和产出 CSV）
货盘/*.xlsx

# Claude Code 本地配置
.claude/
.cursor/
.vscode/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# 系统/编辑器
.DS_Store
Thumbs.db
*.swp
*~

# openclaw 临时产物（如果有的话）
openclaw_output/.tmp/
openclaw_output/*.log

# 敏感信息（绝对别推上去）
.env
.env.*
*.key
*.pem
secrets.yaml
飞书_token*.txt
