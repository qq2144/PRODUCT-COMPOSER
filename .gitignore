__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# Node.js / TypeScript
node_modules/
dist/
.svelte-kit/
*.tsbuildinfo
.pnpm-store/

# 系统/编辑器
.DS_Store
Thumbs.db
*.swp
*~

# 临时可视化产物（不沉淀到仓库）
项目全景图.html

# openclaw 临时产物（如果有的话）
openclaw_output/.tmp/
openclaw_output/*.log

# 部署临时包 / 本地运行包
product-composer-deploy-*.tar.gz
product-composer-runtime-*.tar.gz
.deploy-runtime/

# 敏感信息（绝对别推上去）
.env
.env.*
*.key
*.pem
secrets.yaml
